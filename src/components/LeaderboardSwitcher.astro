---
// Killer tab strip for the per-killer symmetric 1v1 leaderboards. Each pill
// is a plain link to another killer's leaderboard, so switching works without
// JavaScript; the current killer is marked with aria-current. Pills wrap
// rather than scroll so every killer stays visible on narrow screens.
//
// Leaderboards stay out of the sidebar (UX structure §5), so this strip and
// the umbrella link are the way between them.
import { SYMMETRIC_LEADERBOARDS_PATH, type PublicationEntry } from '../lib/ranking/publications';

interface Props {
  entries: PublicationEntry[];
  current: string;
}

const { entries, current } = Astro.props;
---

<nav class="lb-switcher not-content" aria-label="Killer leaderboards">
  <a class="lb-switcher__back" href={SYMMETRIC_LEADERBOARDS_PATH}>
    <span aria-hidden="true">←</span> All symmetric 1v1 leaderboards
  </a>
  <ul class="lb-switcher__list">
    {entries.map(({ slug, label, href }) => (
      <li>
        <a class="lb-switcher__pill" href={href} aria-current={slug === current ? 'page' : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .lb-switcher {
    margin-block: 0.5rem 1.5rem;
  }
  .lb-switcher__back {
    display: inline-block;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .lb-switcher__back:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  .lb-switcher__list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .lb-switcher__pill {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .lb-switcher__pill:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }
  .lb-switcher__pill[aria-current='page'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .lb-switcher a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
