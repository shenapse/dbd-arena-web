---
// Leaderboard rendered from a public ranking snapshot (see
// src/lib/ranking/snapshot.ts). Every label, description, threshold, and
// count comes from the snapshot; this component adds only English UI text.
//
// Each standing is a <details> element: the summary is the standings row and
// the body lists the row's included matches from that player's perspective.
// It works without JavaScript. The small script below only opens a row when
// an opponent link or a URL fragment targets it.
//
// The hosting page supplies the heading: its title is the publication label.
import { formatTimestamp, type LeaderboardView } from '../lib/ranking/snapshot';

interface Props {
  view: LeaderboardView;
}

const { snapshot, boards, ambiguousNames } = Astro.props.view;
const { publication, season } = snapshot;

const showProfileId = (name: string) => ambiguousNames.has(name);
const rounds = (n: number) => `${n} ${n === 1 ? 'round' : 'rounds'}`;
---

<div class="ranking">
  <p>{publication.description}</p>

  <dl class="meta-grid ranking__meta">
    <Fragment>
      <dt>Competition</dt>
      <dd title={publication.competition.description}>{publication.competition.label}</dd>
    </Fragment>
    {publication.scope.map(({ category, value }) => (
      <Fragment>
        <dt title={category.description}>{category.label}</dt>
        <dd title={value.description}>{value.label}</dd>
      </Fragment>
    ))}
    <Fragment>
      <dt>Season</dt>
      <dd>{season.label}</dd>
    </Fragment>
    <Fragment>
      <dt>Season window</dt>
      <dd>
        <time datetime={season.starts_at}>{formatTimestamp(season.starts_at)}</time>
        {' to '}
        <time datetime={season.ends_at}>{formatTimestamp(season.ends_at)}</time>
      </dd>
    </Fragment>
    <Fragment>
      <dt>Snapshot generated</dt>
      <dd><time datetime={snapshot.generated_at}>{formatTimestamp(snapshot.generated_at)}</time></dd>
    </Fragment>
  </dl>

  {boards.map(({ board, headingId, standings }) => {
    const metricCount = snapshot.result_metrics.length;
    // Rank · Player · Score · Matches · metrics… · Opponents · disclosure marker.
    // Every count column gets the same width (sized for the longest header,
    // "Opponents") and values are centred under their headers, so the stats
    // sit on an even rhythm. Below 44rem the stacked layout takes over.
    const countColumns = Array(metricCount + 2).fill('5.5rem');
    const columns = ['3.25rem', 'minmax(0, 1fr)', '7.5rem', ...countColumns, '1rem'].join(' ');
    return (
      <section class="ranking__board" aria-labelledby={headingId}>
        <h2 id={headingId}>{board.label}</h2>
        <p>{board.description}</p>

        <dl class="meta-grid ranking__meta">
          <Fragment>
            <dt title={board.eligibility.rating.description}>Required {board.eligibility.rating.label}</dt>
            <dd>At least {board.eligibility.minimum_rating_value}</dd>
          </Fragment>
          <Fragment>
            <dt>Required matches against eligible players</dt>
            <dd>At least {board.eligibility.minimum_eligible_match_count}</dd>
          </Fragment>
        </dl>

        {standings.length === 0 ? (
          <p>No players meet the eligibility requirements in this snapshot.</p>
        ) : (
          <div class="standings not-content" style={`--standings-columns: ${columns}; --standings-stat-count: ${metricCount + 3}`}>
            <div class="standings__head" aria-hidden="true">
              <span>Rank</span>
              <span>Player</span>
              <span class="num">{board.score_definition.label}</span>
              <span class="num">Matches</span>
              {snapshot.result_metrics.map((m) => <span class="num" title={m.description}>{m.label}</span>)}
              <span class="num">Opponents</span>
              <span />
            </div>
            <ul class="standings__list">
              {standings.map(({ row, profile, anchor, tied, resultCounts, matches }) => (
                <li id={anchor} class="standings__item">
                  <details class="standing">
                    <summary class="standing__summary">
                      <span class="standing__rank">
                        <span class="sr-only">Rank </span>{row.rank}
                        {tied && <span class="sr-only"> (tied)</span>}
                      </span>
                      <span class="standing__name">
                        <span class="standing__display-name">{profile.display_name}</span>
                        {showProfileId(profile.display_name) && (
                          <span class="profile-id" title="Shown because another player has the same name">{profile.profile_id}</span>
                        )}
                      </span>
                      <span class="num standing__score">
                        <span class="cell-label">{board.score_definition.label}</span>{row.display_score}
                      </span>
                      <span class="num">
                        <span class="cell-label">Matches</span>{row.eligible_match_count}
                      </span>
                      {resultCounts.map(({ metric, count }) => (
                        <span class="num">
                          <span class="cell-label">{metric.label}</span>{count}
                        </span>
                      ))}
                      <span class="num">
                        <span class="cell-label">Opponents</span>{row.opponent_count}
                      </span>
                      <span class="standing__marker" aria-hidden="true" />
                    </summary>

                    <div class="standing__detail">
                      <p class="standing__detail-title">
                        Included matches for {profile.display_name}
                        {showProfileId(profile.display_name) && <span class="profile-id">{profile.profile_id}</span>}
                      </p>
                      <div class="standing__table-wrap">
                        <table class="standing__matches">
                          <caption class="sr-only">
                            Matches included in the ranking calculation for {profile.display_name}
                            {showProfileId(profile.display_name) && ` (${profile.profile_id})`}, from their perspective
                          </caption>
                          <thead>
                            <tr>
                              <th scope="col">Match</th>
                              <th scope="col">Opponent</th>
                              <th scope="col">Result</th>
                            </tr>
                          </thead>
                          <tbody>
                            {matches.map((m) => (
                              <tr>
                                <td><code class="match-id">{m.matchId}</code></td>
                                <td>
                                  {m.opponentAnchor ? (
                                    <a href={`#${m.opponentAnchor}`}>{m.opponent.display_name}</a>
                                  ) : (
                                    m.opponent.display_name
                                  )}
                                  {showProfileId(m.opponent.display_name) && (
                                    <span class="profile-id">{m.opponent.profile_id}</span>
                                  )}
                                  {m.encounterTotal > 1 && (
                                    <span class="encounter" title="Repeat encounters share a contribution limit; see Methodology">
                                      meeting {m.encounterIndex} of {m.encounterTotal}
                                    </span>
                                  )}
                                </td>
                                <td>
                                  <span class={`result result--${m.won ? 'won' : 'lost'}`}>
                                    <span aria-hidden="true">{m.won ? '▲' : '▽'}</span>
                                    {m.won ? 'Won' : 'Lost'}
                                  </span>
                                  <span class="rounds">
                                    <span class="sr-only">, {rounds(m.ownRounds)} to {m.opponentRounds}</span>
                                    <span aria-hidden="true">{m.ownRounds}–{m.opponentRounds}</span>
                                  </span>
                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </div>
        )}

        <h3>How scores work</h3>
        <p><strong>{board.score_definition.label}.</strong> {board.score_definition.description}</p>
        <p><strong>Eligibility.</strong> {board.eligibility.description}</p>
        <p><strong>{board.eligibility.rating.label}.</strong> {board.eligibility.rating.description}</p>
      </section>
    );
  })}

  <h2 id="methodology">Methodology</h2>
  <p>{snapshot.methodology_description}</p>
</div>

<script>
  // Open the standing a fragment points at (opponent links, shared URLs).
  // Without JavaScript the link still scrolls to the row; it just stays closed.
  function openTargetedStanding() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const details = document.getElementById(id)?.querySelector('details');
    if (details) details.open = true;
  }
  window.addEventListener('hashchange', openTargetedStanding);
  openTargetedStanding();
</script>

<style>
  .ranking__meta {
    margin-top: 1rem;
  }

  /* ---- Standings ---- */
  .standings {
    margin-top: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    font-size: var(--sl-text-sm);
  }
  .standings__head,
  .standing__summary {
    display: grid;
    grid-template-columns: var(--standings-columns);
    gap: 0.25rem;
    align-items: center;
    padding: 0.6rem 0.9rem;
  }
  .standings__head {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .standings__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .standings__item {
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .standings__item:target .standing__summary {
    box-shadow: inset 3px 0 0 var(--sl-color-accent);
  }
  .num {
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .standings__head > span {
    white-space: nowrap;
  }

  .standing__summary {
    cursor: pointer;
    list-style: none;
  }
  .standing__summary::-webkit-details-marker {
    display: none;
  }
  .standing__summary:hover {
    background: var(--sl-color-gray-6);
  }
  .standing__summary:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .standing__rank {
    font-weight: 700;
    font-size: var(--sl-text-base);
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }
  .standing__name {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }
  .standing__display-name {
    font-weight: 600;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  .standing__score {
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .standing__marker::before {
    content: '▸';
    display: inline-block;
    color: var(--sl-color-gray-3);
    transition: transform 0.15s ease;
  }
  .standing[open] .standing__marker::before {
    transform: rotate(90deg);
  }
  .standing[open] .standing__summary {
    background: var(--sl-color-gray-6);
  }

  /* Cell labels are for screen readers on wide screens and visible on narrow ones. */
  .cell-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .profile-id {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0 0.3rem;
    margin-inline-start: 0.35rem;
    white-space: nowrap;
  }
  .standing__name .profile-id {
    margin-inline-start: 0;
  }

  /* ---- Included matches ---- */
  .standing__detail {
    padding: 0.75rem 0.9rem 1rem;
    border-top: 1px dashed var(--sl-color-gray-5);
  }
  .standing__detail-title {
    margin: 0 0 0.5rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .standing__table-wrap {
    overflow-x: auto;
  }
  .standing__matches {
    width: 100%;
    border-collapse: collapse;
  }
  .standing__matches th,
  .standing__matches td {
    padding: 0.4rem 0.6rem;
    text-align: start;
    border-bottom: 1px solid var(--sl-color-gray-6);
    white-space: nowrap;
  }
  .standing__matches th {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .standing__matches td:nth-child(2) {
    white-space: normal;
  }
  .standing__matches a {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .match-id {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .encounter {
    margin-inline-start: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .result {
    display: inline-flex;
    gap: 0.3rem;
    align-items: baseline;
    font-weight: 600;
  }
  .result--won {
    color: var(--status-active);
  }
  /* The shared green is tuned for dark backgrounds; darken it for contrast on white. */
  :global([data-theme='light']) .result--won {
    color: #1f7a45;
  }
  .rounds {
    margin-inline-start: 0.5rem;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }
  .result--lost {
    color: var(--sl-color-gray-3);
  }

  /* ---- Narrow screens: rank + name on top, stats as labelled chips ---- */
  /* Narrow page: the shared meta-grid sizes its label column to the longest
     label, which is wider than a phone here. Stack label over value. */
  @media (max-width: 40rem) {
    .ranking__meta {
      grid-template-columns: minmax(0, 1fr);
      gap: 0 1rem;
    }
    .ranking__meta dd + dt {
      margin-top: 0.5rem;
    }
  }

  /* Narrow standings (phones, or a tablet with the sidebar open): the full
     grid would crush the Player column, so each row becomes rank + name on
     top and an evenly divided strip of stats below. Queried on the standings
     box itself, not the viewport, because the sidebar changes its width. */
  .standings {
    container: standings / inline-size;
  }
  @container standings (max-width: 44rem) {
    .standings__head {
      display: none;
    }
    .standing__summary {
      grid-template-columns: repeat(var(--standings-stat-count), minmax(0, 1fr));
      gap: 0.6rem 0.25rem;
    }
    .standing__rank {
      grid-area: 1 / 1;
    }
    .standing__name {
      grid-area: 1 / 1 / 2 / -2;
      padding-inline-start: 2.25rem;
    }
    .standing__marker {
      grid-area: 1 / -2 / 2 / -1;
      justify-self: end;
    }
    .standing__summary > .num {
      grid-row: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      gap: 0.1rem;
    }
    .cell-label {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
      white-space: normal;
      text-align: center;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-2);
      font-weight: 400;
    }
    .standing__detail {
      padding-inline: 0.6rem;
    }
    .standing__matches th,
    .standing__matches td {
      padding-inline: 0.35rem;
    }
    .encounter {
      display: block;
      margin-inline-start: 0;
    }
  }
</style>
