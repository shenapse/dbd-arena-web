---
// Wide killer artwork shown at the top of a killer's leaderboard page and of
// its per-killer balancing pages (via MarkdownContent.astro).
//
// Art is stored as src/assets/killers/landscape/<scope value ID>.<jpg|jpeg|
// png|webp> and cropped to a wide strip centred a little above the middle,
// where the killer's head and shoulders usually sit. A killer without art
// renders nothing, so a new snapshot never breaks the build. The image is
// decorative (alt=""): the page title already names the killer.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
}

const landscapeFiles = import.meta.glob<ImageMetadata>('../assets/killers/landscape/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const landscapes = new Map(
  Object.entries(landscapeFiles).map(([path, image]) => [path.split('/').pop()!.replace(/\.[^.]+$/, ''), image]),
);

const art = landscapes.get(Astro.props.slug);
// These compositions place the killer's head near the top edge.
const alignTop = ['dredge', 'first', 'unknown'].includes(Astro.props.slug);
---

{art && (
  <div class="killer-banner not-content">
    <Image
      src={art}
      alt=""
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 72rem) 48rem, 100vw"
      format="webp"
      quality={80}
      loading="eager"
      style={alignTop ? 'object-position: 50% 0%' : undefined}
    />
  </div>
)}

<style>
  .killer-banner {
    margin-block: 0 1rem;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    border-radius: 0.5rem;
  }
  .killer-banner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    /* Fade the bottom edge into the page instead of a hard cut. */
    mask-image: linear-gradient(to bottom, #000 75%, transparent);
  }
</style>
