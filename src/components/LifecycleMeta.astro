---
// Normative-page metadata block: status, public version, effective date, and
// change history. Lets a visitor immediately identify what they are reading.
//
// Zero props: status/version/effectiveDate/changeHistory are no longer
// hand-authored per page. English pages under src/content/docs/** are the
// sole source of lifecycle truth (UX spec §6) — this component resolves it
// for the current route instead, so a localized page can never drift out of
// sync with (or duplicate) the English lifecycle it describes.
import StatusBadge from "./StatusBadge.astro";
import { resolveLifecycleForRoute } from "../lib/docs/lifecycle";

const { lifecycle } = await resolveLifecycleForRoute(Astro.locals);
// Labels localized via Starlight i18n (src/content/i18n/*.json).
const t = Astro.locals.t;
---

{lifecycle && (
  <Fragment>
    <dl class="meta-grid">
      <dt>{t('lifecycle.status')}</dt>
      <dd><StatusBadge status={lifecycle.status} /></dd>
      <dt>{t('lifecycle.version')}</dt>
      <dd>{lifecycle.version}</dd>
      <dt>{t('lifecycle.effectiveDate')}</dt>
      <dd>{lifecycle.effectiveDate}</dd>
    </dl>

    <details class="change-history">
      <summary>{t('lifecycle.changeHistory')}</summary>
      <ul>
        {lifecycle.changeHistory.map(c => (
          <li><strong>{c.version}</strong> — <span>{c.date}</span>: {c.note}</li>
        ))}
      </ul>
    </details>
  </Fragment>
)}

<style>
  .change-history {
    margin: 0.5rem 0 1rem;
    font-size: 0.9rem;
  }
  .change-history summary {
    cursor: pointer;
    color: var(--sl-color-gray-3);
  }
  .change-history ul {
    margin: 0.5rem 0 0;
  }
</style>
