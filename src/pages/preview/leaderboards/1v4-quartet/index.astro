---
// Umbrella page for the 1v4 quartet leaderboards: one card per killer that
// has a published snapshot, each with its killer and survivor party boards.
// Unlisted, like every leaderboard preview (UX structure §5): not in the
// sidebar, not searchable, not indexed.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import LeaderboardCards from '@components/LeaderboardCards.astro';
import { UNLISTED_PREVIEW, quartetLeaderboards } from '../../../../lib/ranking/publications';

const { entries } = quartetLeaderboards;
---

<StarlightPage
  frontmatter={{
    title: '1v4 Quartet Leaderboards',
    description: 'Unlisted preview of the per-killer 1v4 quartet leaderboards, rendered from fictional sample snapshots.',
    ...UNLISTED_PREVIEW,
  }}
>
  <Aside type="caution" title="Fictional sample data">
    These previews render the sample ranking snapshots in <code>docs/ref/examples/</code>.
    Players, parties, matches, and scores are made up, and the scores were written by hand
    rather than calculated.
  </Aside>

  <LeaderboardCards entries={entries} />
</StarlightPage>
