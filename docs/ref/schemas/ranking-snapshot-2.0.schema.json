{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ranking Snapshot - public envelope 2.0",
  "description": "Base shape of a ranking snapshot whose schema_version is 2.0. Field meanings and cross-field rules are defined in ranking-system-data-schema.md. Eligibility contents and additional row fields require extension_schema and are validated separately against that whole-snapshot contract. public_facts is validated separately against public_facts_schema. Reference resolution, uniqueness by key, row order and ranks, opponent counts, and season bounds require whole-snapshot checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "generated_at",
    "publication",
    "season",
    "methodology_description",
    "boards",
    "profiles",
    "result_metrics",
    "public_outcomes",
    "side_definitions",
    "role_definitions",
    "public_facts_schema",
    "included_matches"
  ],
  "properties": {
    "schema_version": {
      "description": "Public envelope version. DS Section 8.",
      "const": "2.0"
    },
    "deployment_id": {
      "$ref": "#/$defs/PublicId",
      "description": "Publisher's stable identity namespace. DS Section 2.1."
    },
    "generated_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "publication": {
      "$ref": "#/$defs/PublicPublication"
    },
    "season": {
      "$ref": "#/$defs/PublicSeason"
    },
    "methodology_description": {
      "$ref": "#/$defs/PublicText",
      "description": "Explains ranking scores and applicable calculation policies. DS Section 3.4."
    },
    "boards": {
      "description": "Public board order. Unique by board_id.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/RankingBoard"
      }
    },
    "profiles": {
      "description": "Unique by profile_id. Includes every profile referenced by rows and match participants.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublicRankingProfile"
      }
    },
    "result_metrics": {
      "description": "Defines row result counts. Unique by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublicDefinition"
      }
    },
    "public_outcomes": {
      "description": "Defines match outcomes. Unique by id.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/PublicDefinition"
      }
    },
    "side_definitions": {
      "description": "Defines the sides used in match summaries. Unique by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublicDefinition"
      }
    },
    "role_definitions": {
      "description": "Defines optional competitive roles used in match summaries. Unique by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublicDefinition"
      }
    },
    "public_facts_schema": {
      "$ref": "#/$defs/PublicSchemaReference"
    },
    "included_matches": {
      "description": "Only matches included in this snapshot's ranking calculation. Unique by match_id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/IncludedMatchEvidence"
      }
    },
    "extension_schema": {
      "$ref": "#/$defs/PublicSchemaReference",
      "description": "Optional effective whole-snapshot extension contract. Required for eligibility or additional row fields. DS Section 4.3."
    }
  },
  "$defs": {
    "PublicId": {
      "description": "Opaque identifier. Compared exactly and case-sensitively. DS Section 2.",
      "type": "string",
      "minLength": 1
    },
    "PublicText": {
      "description": "Plain text with at least one non-whitespace character. DS Section 2.",
      "type": "string",
      "pattern": "\\S"
    },
    "Timestamp": {
      "description": "RFC 3339 timestamp with an explicit UTC offset. DS Section 2.",
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "Count": {
      "type": "integer",
      "minimum": 0
    },
    "RelativeUrlPath": {
      "description": "Non-empty relative URL path, resolved against the snapshot URL. Must not carry a scheme or authority. DS Section 6.3.",
      "type": "string",
      "minLength": 1,
      "format": "uri-reference",
      "not": {
        "pattern": "^([A-Za-z][A-Za-z0-9+.-]*:|//)"
      }
    },
    "PublicDefinition": {
      "description": "DS Section 2.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/PublicId"
        },
        "label": {
          "$ref": "#/$defs/PublicText"
        },
        "description": {
          "$ref": "#/$defs/PublicText"
        }
      }
    },
    "PublicPublication": {
      "description": "DS Section 3.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "label",
        "description",
        "competition",
        "scope"
      ],
      "properties": {
        "publication_id": {
          "$ref": "#/$defs/PublicId"
        },
        "label": {
          "$ref": "#/$defs/PublicText"
        },
        "description": {
          "$ref": "#/$defs/PublicText"
        },
        "competition": {
          "$ref": "#/$defs/PublicDefinition"
        },
        "scope": {
          "description": "Unique by category.id. Empty means the whole competition.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicScopeSelection"
          }
        }
      }
    },
    "PublicScopeSelection": {
      "description": "DS Section 3.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "value"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/PublicDefinition"
        },
        "value": {
          "$ref": "#/$defs/PublicDefinition"
        }
      }
    },
    "PublicSeason": {
      "description": "DS Section 3.3. ends_at must be after starts_at.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season_id",
        "label",
        "starts_at",
        "ends_at"
      ],
      "properties": {
        "season_id": {
          "$ref": "#/$defs/PublicId"
        },
        "label": {
          "$ref": "#/$defs/PublicText"
        },
        "starts_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "ends_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "RankingBoard": {
      "description": "DS Section 4.1.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_id",
        "label",
        "description",
        "score_definition",
        "rows"
      ],
      "properties": {
        "board_id": {
          "$ref": "#/$defs/PublicId"
        },
        "label": {
          "$ref": "#/$defs/PublicText"
        },
        "description": {
          "$ref": "#/$defs/PublicText"
        },
        "score_definition": {
          "$ref": "#/$defs/PublicScoreDefinition"
        },
        "eligibility": {
          "type": "object",
          "description": "Optional, non-null object with no base-defined children. Contents belong to extension_schema. DS Section 4.3."
        },
        "rows": {
          "description": "Authoritative ranking order. Unique by profile_id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RankingRow"
          }
        }
      }
    },
    "PublicScoreDefinition": {
      "description": "DS Section 4.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/PublicText"
        },
        "description": {
          "$ref": "#/$defs/PublicText"
        }
      }
    },
    "RankingRow": {
      "description": "DS Section 4.4.",
      "type": "object",
      "required": [
        "rank",
        "profile_id",
        "display_score",
        "result_counts",
        "opponent_count",
        "included_match_ids"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "profile_id": {
          "$ref": "#/$defs/PublicId"
        },
        "display_score": {
          "type": "integer"
        },
        "result_counts": {
          "description": "Keys are exactly result_metrics[].id.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/PublicId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Count"
          }
        },
        "opponent_count": {
          "$ref": "#/$defs/Count"
        },
        "included_match_ids": {
          "description": "Unique references to included_matches supporting this row. Each match includes this row profile. No eligibility count is implied.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PublicId"
          }
        }
      },
      "$comment": "Leave additional row properties unevaluated so an effective extension can declare and close them with unevaluatedProperties. The root conditional closes rows when extension_schema is absent."
    },
    "PublicRankingProfile": {
      "description": "DS Section 5.1. kind selects the variant.",
      "oneOf": [
        {
          "$ref": "#/$defs/ParticipantProfile"
        },
        {
          "$ref": "#/$defs/GroupProfile"
        }
      ]
    },
    "ParticipantProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "kind",
        "display_name",
        "group_members"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/PublicId"
        },
        "kind": {
          "const": "participant"
        },
        "display_name": {
          "$ref": "#/$defs/PublicText"
        },
        "group_members": {
          "type": "null"
        }
      }
    },
    "GroupProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "kind",
        "display_name",
        "group_members"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/PublicId"
        },
        "kind": {
          "const": "group"
        },
        "display_name": {
          "$ref": "#/$defs/PublicText"
        },
        "group_members": {
          "description": "Unique by profile_id. Empty means no members are published.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicGroupMemberProfile"
          }
        }
      }
    },
    "PublicGroupMemberProfile": {
      "description": "DS Section 5.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "display_name"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/PublicId"
        },
        "display_name": {
          "$ref": "#/$defs/PublicText"
        }
      }
    },
    "IncludedMatchEvidence": {
      "description": "DS Section 6.1.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "sides",
        "outcome_id",
        "played_at",
        "public_facts"
      ],
      "properties": {
        "match_id": {
          "$ref": "#/$defs/PublicId"
        },
        "sides": {
          "description": "Public display order. Unique by side_id.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PublicMatchSide"
          }
        },
        "outcome_id": {
          "$ref": "#/$defs/PublicId"
        },
        "played_at": {
          "description": "Wall-clock time the match took place. Null when the publisher has no reliable time. Informational only. Added in 1.1. DS Section 6.1.",
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "public_facts": {
          "description": "Validated separately against public_facts_schema.",
          "type": "object"
        }
      }
    },
    "PublicMatchSide": {
      "description": "DS Section 6.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side_id",
        "participants"
      ],
      "properties": {
        "side_id": {
          "$ref": "#/$defs/PublicId"
        },
        "participants": {
          "description": "Public display order. A profile appears only once per match.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PublicMatchParticipant"
          }
        }
      }
    },
    "PublicMatchParticipant": {
      "description": "DS Section 6.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "role_ids"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/PublicId"
        },
        "role_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PublicId"
          }
        }
      }
    },
    "PublicSchemaReference": {
      "description": "DS Section 6.3.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "schema_path",
        "documentation_path",
        "description"
      ],
      "properties": {
        "schema_id": {
          "$ref": "#/$defs/PublicId"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_path": {
          "$ref": "#/$defs/RelativeUrlPath"
        },
        "documentation_path": {
          "$ref": "#/$defs/RelativeUrlPath"
        },
        "description": {
          "$ref": "#/$defs/PublicText"
        }
      }
    }
  },
  "if": {
    "not": {
      "required": [
        "extension_schema"
      ]
    }
  },
  "then": {
    "properties": {
      "boards": {
        "items": {
          "properties": {
            "eligibility": false,
            "rows": {
              "items": {
                "$ref": "#/$defs/RankingRow",
                "unevaluatedProperties": false
              }
            }
          }
        }
      }
    }
  }
}
